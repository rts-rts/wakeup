[Unit]
Description=Wake-on-LAN monitor: ping hosts, send WoL, alert via Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/user/wakeup/wakeup_monitor.sh
WorkingDirectory=/home/user/wakeup
StandardOutput=journal
StandardError=journal
# Worst case: MAX_HOSTS * MAX_ATTEMPTS * WAIT = generous ceiling
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
